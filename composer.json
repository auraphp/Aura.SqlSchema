{
    "name": "aura/sqlschema",
    "type": "library",
    "description": "Provides facilities to read table names and table columns from a database using PDO.",
    "keywords": [
        "mysql",
        "pdo",
        "pgsql",
        "postgres",
        "postgresql",
        "sqlite",
        "sql server",
        "sqlserver",
        "sqlsrv",
        "schema",
        "db",
        "database",
        "sql",
        "ddl"
    ],
    "homepage": "https://github.com/auraphp/Aura.SqlSchema",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Aura.SqlSchema Contributors",
            "homepage": "https://github.com/auraphp/Aura.SqlSchema/contributors"
        }
    ],
    "require": {
        "php": ">=5.3.0"
    },
    "autoload": {
        "psr-4": {
            "Aura\\SqlSchema\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^5.7.21 || ^6.4.4 || ^7.5 || ^8.5 || ^9.6 || ^11.0",
        "yoast/phpunit-polyfills": "^2.0.5 || ^3.1.2 || ^4.0.0"
    },
    "extra": {
        "aura": {
            "type": "library"
        }
    }
}
