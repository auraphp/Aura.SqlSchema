<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="./phpunit.php"
         colors="true">
    <testsuites>
        <testsuite name="Aura.SqlSchema">
            <directory>./tests</directory>
            <!-- a shared base class, not a suite of its own -->
            <exclude>./tests/AbstractSchemaTest.php</exclude>
        </testsuite>
    </testsuites>
</phpunit>
